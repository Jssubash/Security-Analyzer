<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mendix Studio Pro extension: Security Analyzer.

    Compiled against the 10.23 Extensions API, the newest 10.x package on NuGet below 10.24.0, so
    the extension references an API version every supported Studio Pro (10.24.0 and later,
    including 11.x) provides. Studio Pro supplies the API assembly and its dependencies at
    runtime; none of them are copied into the output.

    Studio Pro 10.24 runs on .NET 8 and 11.x on .NET 10; a net8.0 assembly loads in both.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SecurityAnalyzer</AssemblyName>
    <RootNamespace>MendixGovernance.SecurityAnalyzer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Mendix Security Analyzer</Product>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mendix.StudioPro.ExtensionsAPI" Version="10.23.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The pane's web page, produced by `npm run build` (scripts/build.mjs). -->
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireWebAssets" BeforeTargets="Build">
    <Error Condition="!Exists('wwwroot\app.js')" Text="wwwroot\app.js is missing. Run `npm run build` in apps/security-analyzer-extension before building the extension." />
  </Target>

</Project>
